{
  "ConnectionStrings": {
    "Database": "Data Source=identity.db"
  },
  "Jwt": {
    "Issuer": "CommerceFlow.Identity",
    "Audience": "CommerceFlow",
    "AccessTokenMinutes": 15
  },
  "RefreshToken": {
    "LifetimeDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
