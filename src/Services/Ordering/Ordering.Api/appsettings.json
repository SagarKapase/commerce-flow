{
  "ConnectionStrings": {
    "Database": "Data Source=ordering.db"
  },
  "Jwt": {
    "Issuer": "CommerceFlow.Identity",
    "Audience": "CommerceFlow"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Basket": {
      "BaseUrl": "https://localhost:7103",
      "TimeoutSeconds": 5
    },
    "Inventory": {
      "BaseUrl": "https://localhost:7104",
      "TimeoutSeconds": 5
    },
    "Payment": {
      "BaseUrl": "https://localhost:7106",
      "TimeoutSeconds": 5
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "commerceflow",
    "UserName": "commerceflow",
    "ExchangeName": "commerceflow.events",
    "DeadLetterExchangeName": "commerceflow.dlx"
  }
}
