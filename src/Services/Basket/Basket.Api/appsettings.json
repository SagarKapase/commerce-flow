{
  "ConnectionStrings": {
    "Database": "Data Source=basket.db"
  },
  "Jwt": {
    "Issuer": "CommerceFlow.Identity",
    "Audience": "CommerceFlow"
  },
  "Services": {
    "Catalog": {
      "BaseUrl": "https://localhost:7101",
      "TimeoutSeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
