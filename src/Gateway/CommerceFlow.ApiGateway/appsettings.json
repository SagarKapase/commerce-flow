{
  "Jwt": {
    "Issuer": "CommerceFlow.Identity",
    "Audience": "CommerceFlow"
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },

  // =====================================================================
  // THE ROUTING TABLE - AND THE MOST IMPORTANT THING ABOUT IT IS WHAT IS
  // MISSING. Scroll to the bottom of Routes before reading anything else.
  //
  // Paths are NOT rewritten. /api/products at the gateway is /api/products at
  // Catalog. A client can move from calling a service directly to calling it
  // through the gateway by changing the host and nothing else, and a URL in a
  // log means the same thing wherever you found it.
  //
  // The alternative - prefixes like /catalog/api/products - is worth knowing
  // about: it makes ownership obvious in the URL and prevents collisions
  // between services that both want /api/items. Our paths are already unique
  // per service, so the prefix would buy nothing and cost every client a
  // rewrite rule.
  // =====================================================================
  "ReverseProxy": {
    "Routes": {
      // Catalog: the gateway passes these through WITHOUT an authorization
      // check, because GET /api/products is public while POST /api/products is
      // Admin-only - the same path, different verb. The gateway cannot tell
      // those apart without a route per verb, and more importantly it should
      // not try: which verb needs which role is Catalog's business, and
      // duplicating it here means two places to get it wrong.
      //
      // THE GENERAL RULE: a gateway does COARSE authentication ("is this token
      // real?"). Services do FINE authorization ("may you do this, to this
      // row?"). Fine-grained rules depend on the data, and the gateway does not
      // have the data.
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**remainder}" },
        "AuthorizationPolicy": "anonymous"
      },

      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/categories/{**remainder}" },
        "AuthorizationPolicy": "anonymous"
      },

      // Anonymous by necessity: these are the endpoints you call when you have
      // no token yet. Requiring one would be circular.
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**remainder}" },
        "AuthorizationPolicy": "anonymous"
      },

      // Every endpoint behind these three requires a token, so the gateway can
      // reject anonymous traffic at the edge and save a network hop. "default"
      // means the application's default policy: an authenticated user.
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**remainder}" },
        "AuthorizationPolicy": "default"
      },

      "basket": {
        "ClusterId": "basket",
        "Match": { "Path": "/api/basket/{**remainder}" },
        "AuthorizationPolicy": "default"
      },

      "orders": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/orders/{**remainder}" },
        "AuthorizationPolicy": "default"
      },

      // ---------------------------------------------------------------
      // INVENTORY IS EXPOSED ONLY PARTIALLY, AND THE ROUTE PATTERNS ARE
      // HOW THAT IS ENFORCED.
      //
      // Note there is no {**remainder} here. These two routes match exactly
      // two shapes of URL:
      //
      //   /api/inventory/<a guid>      "how many are left?" - a shop front
      //                                 wants this
      //   /api/inventory/adjustments   an operator receiving a delivery
      //
      // The :guid constraint is doing real work. "reservations" is not a guid,
      // so /api/inventory/reservations/... matches NEITHER route - and because
      // there is no catch-all to fall through to, the gateway answers 404
      // without ever contacting Inventory.
      // ---------------------------------------------------------------
      "inventory-stock": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{productId:guid}" },
        "AuthorizationPolicy": "default"
      },

      "inventory-adjustments": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/adjustments" },
        "AuthorizationPolicy": "default"
      }

      // =============================================================
      // WHAT IS DELIBERATELY ABSENT, AND WHY THIS IS THE POINT OF THE PHASE
      //
      //   /api/payments/**                     no route
      //   /api/inventory/reservations/**       no route
      //
      // Both were flagged as open questions when they were written:
      //
      //   Phase 6 (InventoryReservationsController): "[Authorize] with no
      //     role is looser than it should be - it is a placeholder rather
      //     than a decision."
      //   Phase 9 (PaymentsController): "this service takes the AMOUNT from
      //     its caller... a customer who could reach POST /api/payments
      //     directly could pay one paisa for a laptop."
      //
      // This file is the answer, and it is the cheapest of the three that
      // were on the table: INTERNAL SERVICES STAY INTERNAL BECAUSE NOTHING
      // OUTSIDE CAN ADDRESS THEM. No new code, no new credential, no check
      // anybody can forget to write - just the absence of a route.
      //
      // Ordering still reaches both, because Ordering calls them directly at
      // localhost:7104 and 7106 rather than through the gateway. That is the
      // usual shape of a real system: the gateway is the NORTH-SOUTH door for
      // traffic from outside, while EAST-WEST traffic between services stays
      // on the internal network and never passes through it.
      //
      // In production the internal services would also not be publicly
      // routable at all - a private subnet, a Kubernetes ClusterIP service, a
      // firewall rule. On one laptop, everything listens on localhost, so this
      // routing table is the only enforcement there is. Worth being honest
      // about: a determined caller on THIS machine can still reach
      // https://localhost:7106 directly. The gateway removes the door, not the
      // wall - the wall is the network, and we do not have one.
      // =============================================================
    },

    "Clusters": {
      // A cluster is a named group of destinations. Each has exactly one here,
      // but the shape is why: add a second address and YARP load-balances
      // across them, with no change to any route. Scaling out is a config edit.
      "catalog": {
        "Destinations": { "primary": { "Address": "https://localhost:7101/" } }
      },
      "identity": {
        "Destinations": { "primary": { "Address": "https://localhost:7102/" } }
      },
      "basket": {
        "Destinations": { "primary": { "Address": "https://localhost:7103/" } }
      },
      "inventory": {
        "Destinations": { "primary": { "Address": "https://localhost:7104/" } }
      },
      "ordering": {
        "Destinations": { "primary": { "Address": "https://localhost:7105/" } }
      }

      // There is no "payment" cluster. Not an empty one, not a commented-out
      // one - the gateway has never been told the payment service exists.
    },

    // Active health checks would go here, polling a /health endpoint on each
    // destination and taking unhealthy ones out of rotation automatically.
    // Our services have no /health endpoint yet; that arrives with the
    // observability work, and this is where it gets wired up.
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // YARP logs every proxied request: the route it matched, the cluster it
      // chose and how long the destination took. Leave this on while working
      // through the phase - it is how you see the routing decision rather than
      // guessing at it.
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
