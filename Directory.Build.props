<Project>

  <!--
    MSBuild automatically imports this file into EVERY .csproj under this
    folder, before the project's own contents are read. That means settings
    live in one place instead of being copy-pasted into eight project files.

    Because these properties are defined here, each .csproj can stay almost
    empty - open one and you will see only its references, which is exactly
    the information you want when reading a project.

    To upgrade the whole solution to a new .NET version later, you change
    TargetFramework here once.
  -->

  <PropertyGroup>
    <!-- Every project targets .NET 10 (LTS). -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Nullable reference types on: the compiler warns when a string that
         cannot be null might be, and when a possibly-null value is used
         without a check. This is why `Product?` in a method signature is
         meaningful documentation and not just decoration. -->
    <Nullable>enable</Nullable>

    <!-- Common usings (System, System.Linq, ...) are added automatically.
         The generated file is real and readable:
         obj/Debug/net10.0/<Project>.GlobalUsings.g.cs -->
    <ImplicitUsings>enable</ImplicitUsings>

    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
